# Copy this file to .env and replace every example value before building or deploying.
CLIPS_BASE_URL=https://clips.example.com
CLIPS_UPDATE_PATH=/cdn
CLIPS_TELEMETRY_PATH=/telemetry

CLIPS_FRONT_DOMAIN=clips.example.com

# Only needed while the legacy Workers remain deployed.
CLIPS_LEGACY_UPDATE_DOMAIN=cdn.clips.example.com
CLIPS_LEGACY_TELEMETRY_DOMAIN=telemetry.clips.example.com

CLIPS_FRONT_WORKER=clips-front-door
CLIPS_UPDATE_WORKER=clips-updates
CLIPS_TELEMETRY_WORKER=clips-telemetry
CLIPS_UPDATE_BUCKET=clips-updates
CLIPS_TELEMETRY_BUCKET=clips-telemetry

# Optional override. The default private signing-key path is ignored under .clips-private/.
CLIPS_UPDATE_SIGNING_KEY=.clips-private/update-signing-private.pem
