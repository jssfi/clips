{
  "appId": "io.clips.desktop",
  "productName": "jss clips",
  "files": [
    "src/**/*",
    "scripts/update-signature.js",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "legal",
      "to": "legal"
    },
    {
      "from": "vendor/libobs",
      "to": "libobs"
    },
    {
      "from": "vendor/capture-host/clips-capture-host.exe",
      "to": "capture-host/clips-capture-host.exe"
    },
    {
      "from": "vendor/ffmpeg",
      "to": "ffmpeg"
    },
    {
      "from": "vendor/libmpv/mpv-host.exe",
      "to": "libmpv/mpv-host.exe"
    },
    {
      "from": "vendor/libmpv/libmpv-2.dll",
      "to": "libmpv/libmpv-2.dll"
    },
    {
      "from": "vendor/mpv/mpv.exe",
      "to": "mpv/mpv.exe"
    },
    {
      "from": "node_modules/7zip-bin/win/x64/7za.exe",
      "to": "tools/7za.exe"
    }
  ],
  "asar": true,
  "compression": "normal",
  "win": {
    "icon": "assets/app-icon.ico",
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "jss-clips-setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "jss-clips-portable-${version}-${arch}.${ext}"
  }
}
